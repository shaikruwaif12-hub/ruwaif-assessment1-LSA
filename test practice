# Password Strength Checker

password = input("Enter Password: ")

has_upper = False
has_lower = False
has_digit = False
has_special = False

# Check each character
for i in password:
    if i.isupper():
        has_upper = True
    elif i.islower():
        has_lower = True
    elif i.isdigit():
        has_digit = True
    else:
        has_special = True

# Validate password
if (len(password) >= 8 and has_upper and has_lower and
        has_digit and has_special):
    print("Strong Password")
else:
    print("Invalid")
    
    
    
