# Event Attendance Analysis

registered = {"Asha", "Rahul", "John", "Meera", "Ali", "Sara"}
attended = {"Asha", "John", "Meera", "Ali"}

# Number of registered participants
total_registered = len(registered)

# Number of attendees
total_attendees = len(attended)

# People who registered but did not attend
absent = registered - attended

# Attendance percentage
attendance_percentage = (total_attendees / total_registered) * 100

# Display results
print("Number of Registered Participants:", total_registered)
print("Number of Attendees:", total_attendees)
print("People who Registered but did not Attend:", absent)
print("Attendance Percentage:", attendance_percentage, "%")


